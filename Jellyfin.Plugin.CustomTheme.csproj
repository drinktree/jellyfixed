<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.CustomTheme</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.CustomTheme</RootNamespace>
    <Version>3.3.1.0</Version>
    <AssemblyVersion>3.3.1.0</AssemblyVersion>
    <FileVersion>3.3.1.0</FileVersion>
  </PropertyGroup>

  <!-- The bundled File Transformation provider is a separate assembly so its name
       contains ".FileTransformation"; exclude its sources from this project and
       reference it instead. -->
  <ItemGroup>
    <Compile Remove="FileTransformation/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FileTransformation/CustomTheme.FileTransformation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
  </ItemGroup>

  <!-- ASP.NET types for the self-contained index.html injection middleware
       (IStartupFilter, IApplicationBuilder, HttpContext, StreamResponseBodyFeature). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="netflix.css" />
    <EmbeddedResource Include="configPage.html" />
    <EmbeddedResource Include="headerButton.js" />
  </ItemGroup>

  <!-- Brand images, read by CssGenerator and sent out as data: URIs inside the
       stylesheet. LogicalName is explicit because MSBuild derives a manifest name
       from the folder path, and the hyphen in the file names is exactly the kind
       of character it rewrites. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/villa-emblem.webp" LogicalName="Jellyfin.Plugin.CustomTheme.Assets.villa-emblem.webp" />
    <EmbeddedResource Include="Assets/villa-signature.webp" LogicalName="Jellyfin.Plugin.CustomTheme.Assets.villa-signature.webp" />
    <EmbeddedResource Include="Assets/villa-lockup.webp" LogicalName="Jellyfin.Plugin.CustomTheme.Assets.villa-lockup.webp" />
    <!-- Served by ThemeAssetsController: the tab icon and the home-screen / web-app icons. -->
    <EmbeddedResource Include="Assets/villa-favicon-64.png" LogicalName="Jellyfin.Plugin.CustomTheme.Assets.villa-favicon-64.png" />
    <EmbeddedResource Include="Assets/villa-icon-180.png" LogicalName="Jellyfin.Plugin.CustomTheme.Assets.villa-icon-180.png" />
    <EmbeddedResource Include="Assets/villa-icon-192.png" LogicalName="Jellyfin.Plugin.CustomTheme.Assets.villa-icon-192.png" />
    <EmbeddedResource Include="Assets/villa-icon-512.png" LogicalName="Jellyfin.Plugin.CustomTheme.Assets.villa-icon-512.png" />
  </ItemGroup>

</Project>
